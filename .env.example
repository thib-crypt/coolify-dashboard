# --- Coolify instance -------------------------------------------------------
# Root URL, without /api/v1. The API must be enabled on the instance
# (Settings → Advanced → API Access) and this host must pass its IP allowlist.
COOLIFY_URL=https://coolify.example.com

# Token from Security → API Tokens, created by an admin/owner of the team.
# Abilities: `read` to display anything, `read:sensitive` for deployment logs,
# `deploy` for deploy/cancel/restart/stop, and `write` for the auto-deploy
# toggle and running a scheduled task. Missing abilities surface as a toast
# naming what to add — the dashboard keeps working without them.
COOLIFY_TOKEN=

# --- BFF --------------------------------------------------------------------
# Port the BFF listens on. BFF_PORT takes precedence over PORT, which some
# tooling injects into the shared dev environment.
BFF_PORT=8787
# Where the SQLite snapshot file lives (KPI deltas and sparklines).
DATA_DIR=./data
# Upstream request timeout, in ms.
COOLIFY_TIMEOUT_MS=10000
# Deployments fetched per application when building the 24 h history.
DEPLOYMENT_HISTORY_TAKE=20

# --- Live channel (phase 3) -------------------------------------------------
# Shared secret for the incoming-webhook route. Coolify's outgoing webhooks are
# *unsigned*, so this secret in the URL is the only authentication there is:
#   PATCH /api/v1/notifications/webhook
#   { "webhook_enabled": true,
#     "webhook_url": "https://<dashboard>/app/hooks/coolify?secret=<this>" }
# Leave it empty and the route answers 503 — the dashboard then relies on
# polling alone, which is a few seconds slower but never blind.
# Note: Coolify refuses webhook URLs pointing at loopback/private addresses
# unless the instance operator allowlisted them (`SafeWebhookUrl`).
WEBHOOK_SECRET=

# How often the BFF asks Coolify for the running deployments. The idle value is
# how long a deployment started from Coolify's own UI stays invisible here:
# Coolify sends no webhook when a build *begins*, only when it ends.
# The poller stops entirely while no browser is connected.
POLL_ACTIVE_MS=2500
POLL_IDLE_MS=4000
