# --- Coolify instance -------------------------------------------------------
# Root URL, without /api/v1. The API must be enabled on the instance
# (Settings → Advanced → API Access) and this host must pass its IP allowlist.
COOLIFY_URL=https://coolify.example.com

# Token from Security → API Tokens, created by an admin/owner of the team.
# Abilities: `read` to display anything, `read:sensitive` for deployment logs,
# `deploy` for deploy/cancel/restart/stop, and `write` for the auto-deploy
# toggle and running a scheduled task. Missing abilities surface as a toast
# naming what to add — the dashboard keeps working without them.
COOLIFY_TOKEN=

# --- BFF --------------------------------------------------------------------
# Port the BFF listens on. BFF_PORT takes precedence over PORT, which some
# tooling injects into the shared dev environment.
BFF_PORT=8787
# Interface to bind. Loopback by default: without DASHBOARD_PASSWORD below,
# anyone who can reach this port can deploy and stop things. The container sets
# 0.0.0.0 and warns at boot if it does that with no password — see
# docs/deployment.md.
BFF_HOST=127.0.0.1
# Built SPA to serve alongside the API, so that one process answers everything.
# Leave it empty to run the BFF API-only; a directory with no index.html is
# ignored, which is what development wants (Vite serves the front end there).
STATIC_DIR=dist
# Where the SQLite snapshot file lives (KPI deltas and sparklines).
DATA_DIR=./data
# Upstream request timeout, in ms.
COOLIFY_TIMEOUT_MS=10000
# Deployments fetched per application when building the 24 h history.
DEPLOYMENT_HISTORY_TAKE=20

# --- The dashboard's own front door -----------------------------------------
# Set this and the dashboard asks for it once, then keeps a signed session
# cookie. Leave it empty and every route stays open — fine on loopback or a
# private network, not on a domain: /app/deploy and /app/applications/{uuid}/stop
# are unauthenticated writes without it.
#
# There is one password, not a user list: this is a companion to one Coolify
# instance, and the API token it holds is already a single shared credential.
DASHBOARD_PASSWORD=

# Key used to sign the session cookie. Optional: it defaults to the password
# itself, which means changing the password signs everyone out — usually what
# you want. Set it explicitly (any long random string) if you would rather that
# a password change kept existing sessions, or if several replicas must accept
# each other's cookies.
SESSION_SECRET=

# How long a session lasts before the password is asked for again.
SESSION_TTL_HOURS=168

# --- Live channel: SSE + incoming webhooks ----------------------------------
# Shared secret for the incoming-webhook route. Coolify's outgoing webhooks are
# *unsigned*, so this secret in the URL is the only authentication there is:
#   PATCH /api/v1/notifications/webhook
#   { "webhook_enabled": true,
#     "webhook_url": "https://<dashboard>/app/hooks/coolify?secret=<this>" }
# Leave it empty and the route answers 503 — the dashboard then relies on
# polling alone, which is a few seconds slower but never blind.
# Note: Coolify refuses webhook URLs pointing at loopback/private addresses
# unless the instance operator allowlisted them (`SafeWebhookUrl`).
WEBHOOK_SECRET=

# How often the BFF asks Coolify for the running deployments. The idle value is
# how long a deployment started from Coolify's own UI stays invisible here:
# Coolify sends no webhook when a build *begins*, only when it ends.
# The poller stops entirely while no browser is connected.
POLL_ACTIVE_MS=2500
POLL_IDLE_MS=4000

# --- Probes: uptime, latency, certificate expiry ----------------------------
# The BFF checks each application's public domain over HTTP, every minute, and
# stores every result: that measured history *is* the uptime column, because
# Coolify tracks no uptime of its own. The same loop reads the TLS certificate
# (hourly — expiry only moves once) and TCP-pings each server for the latency
# the API does not expose.
#
# These requests go to your own applications, not to the Coolify API, so they
# spend none of its 200 req/min budget. Unlike the deployment poller, the loop
# keeps running with no browser connected — an uptime measured only while
# someone is looking is not an uptime.
#
# Set to false to turn all of it off. The dashboard then shows "—" for uptime,
# latency and certificates, and says so in its degraded notes, rather than
# inventing numbers.
PROBES_ENABLED=true
# How often each application is probed. Every result is one row in SQLite.
PROBE_INTERVAL_MS=60000
# Give up on a probe after this long; a timeout counts as an outage.
PROBE_TIMEOUT_MS=5000
# How often the TLS certificate of each https domain is re-read.
PROBE_TLS_INTERVAL_MS=3600000
# How many probes run at once — one HTTP request per application per cycle.
PROBE_CONCURRENCY=6
# How long probe samples are kept. Uptime is computed over the last 24 h.
PROBE_RETENTION_DAYS=7
# Restrict probing to these applications (names or uuids, comma-separated).
# Empty = every application with a public domain. Useful when some of them are
# behind a VPN, rate-limited, or simply not yours to hammer.
PROBE_APPS=

# --- Server metrics: Sentinel over SSH --------------------------------------
# Coolify has **no REST endpoint for CPU or RAM**. Its own charts SSH into the
# server and run `docker exec coolify-sentinel curl http://localhost:8888/…`
# against Sentinel, the agent it installs on every managed host. The API only
# exposes Sentinel's *configuration* (`/api/v1/servers/{uuid}/sentinel`).
#
# So there are two honest modes, and the SSH key is the switch between them:
#
#  · no key (default)  the CPU and MEM gauges stay empty and say why on hover,
#                      and the BFF makes zero extra upstream calls;
#  · key set           the BFF makes the same SSH round trip Coolify makes and
#                      the gauges show real percentages.
#
# Requirements for the second mode:
#  1. an `ssh` client in the runtime (the Docker image ships one);
#  2. a private key accepted by the servers — the same one Coolify uses, or a
#     dedicated read-only key you add to their `authorized_keys`;
#  3. `read:sensitive` on COOLIFY_TOKEN, because `sentinel_token` is withheld
#     without it;
#  4. Sentinel metrics enabled per server:
#       curl -X PATCH "$COOLIFY_URL/api/v1/servers/<uuid>/sentinel" \
#            -H "Authorization: Bearer $COOLIFY_TOKEN" \
#            -H 'Content-Type: application/json' \
#            -d '{"is_sentinel_enabled":true,"is_metrics_enabled":true}'
#
# Path to the private key. Setting it IS the opt-in — leave it empty and no
# collector runs at all.
METRICS_SSH_KEY=
# Overrides that opt-in in either direction, and is left unset on purpose:
#   METRICS_ENABLED=false  keeps the collector off even with a key set;
#   METRICS_ENABLED=true   runs it *without* METRICS_SSH_KEY, which only makes
#                          sense outside a container, where ssh already finds
#                          the right identity through an agent or ~/.ssh/config.
# Setting it to true with no key and no agent makes every server report an SSH
# failure instead of an empty gauge — noisier, not more informative.
# METRICS_ENABLED=
# How often each server is queried. Like the deployment poller — and unlike the
# uptime probes — this loop stops entirely while no browser is connected: a
# gauge builds up no history, so a reading nobody looks at is a wasted SSH.
METRICS_INTERVAL_MS=30000
# Whole budget for one server: SSH handshake plus both curls.
METRICS_TIMEOUT_MS=12000
# Login to use. Empty = whatever `GET /servers` reports for each server.
METRICS_SSH_USER=
# Host key policy. `accept-new` pins each server on first sight. Use `no` only
# in an ephemeral container with no writable known_hosts — it stops the SSH
# client from authenticating the server at all.
METRICS_SSH_STRICT_HOST_KEY=accept-new
# How many servers are queried at once.
METRICS_CONCURRENCY=3
# How much history to ask Sentinel for; only the newest point is displayed, and
# a point older than two minutes is reported as stale instead of as current.
METRICS_HISTORY_MINUTES=5
# Restrict collection to these servers (names or uuids, comma-separated).
METRICS_SERVERS=

# Full reference, with what each knob costs and why the defaults are what they
# are: docs/configuration.md
